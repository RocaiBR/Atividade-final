    <config key="annotations">
        <config key="annotation_0">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;Fenty Beauty — consolidação dos atendimentos&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Junta as três fontes do salão em uma tabela só: agenda (SQLite), perfis sensoriais e feedbacks (MongoDB) e clima (API Open-Meteo). Depois aplica as regras de negócio do painel: o nível de tranquilidade de cada atendimento (calmo, moderado, movimentado) e se o dia foi de chuva. O resultado alimenta o painel da gerente no DuckDB. O ramo de baixo monta a mesma tabela como planilha de Excel.&lt;/p&gt;" />
            <entry key="contentType" type="xstring" value="text/html" />
            <entry key="bgcolor" type="xint" value="16777215" />
            <entry key="x-coordinate" type="xint" value="40" />
            <entry key="y-coordinate" type="xint" value="20" />
            <entry key="width" type="xint" value="1540" />
            <entry key="height" type="xint" value="60" />
            <entry key="alignment" type="xstring" value="LEFT" />
            <entry key="borderSize" type="xint" value="10" />
            <entry key="borderColor" type="xint" value="16766976" />
            <entry key="defFontSize" type="xint" value="-1" />
            <entry key="annotation-version" type="xint" value="20230412" />
            <config key="styles" />
        </config>
        <config key="annotation_1">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;Planilha para a gerente (Excel)&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Mesmos dados, prontos para ler: nomes das colunas em português e em ordem, status e Sim/Não por extenso, atendimentos em ordem de data e duas abas de resumo (por profissional e conforto por nível de tranquilidade).&lt;/p&gt;" />
            <entry key="contentType" type="xstring" value="text/html" />
            <entry key="bgcolor" type="xint" value="16777215" />
            <entry key="x-coordinate" type="xint" value="1360" />
